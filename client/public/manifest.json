{
  "manifest_version": 3,
  "name": "Accessify",
  "version": "1.0.0",
  "description": "Reversible reading and accessibility adjustments for webpages.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["storage", "activeTab", "scripting", "tts", "sidePanel", "identity"],
  "side_panel": { "default_path": "index.html?panel=1" },
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://dev-tsmyxcbitdn1q1vy.us.auth0.com/*", "http://127.0.0.1:3000/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/extension-16.png", "32": "icons/extension-32.png", "48": "icons/extension-48.png", "128": "icons/extension-128.png" },
  "action": { "default_icon": { "16": "icons/extension-16.png", "32": "icons/extension-32.png", "48": "icons/extension-48.png", "128": "icons/extension-128.png" } },
  "options_page": "index.html"
}
