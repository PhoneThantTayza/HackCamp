# Copy this file to .env.local in the project root.
# Local development (keep this until the sync server is deployed):
VITE_API_URL=http://127.0.0.1:3000

# After deployment, replace the value above with your real HTTPS server origin.
# Example format: VITE_API_URL=https://your-service.onrender.com
# Rebuild and reload the extension after changing it.
# VITE_ values are public and bundled into the extension. Never add secrets here.
